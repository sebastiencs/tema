# Example configuration for tema.
# Copy to:  ~/.config/tema/config.toml
#     or:  $XDG_CONFIG_HOME/tema/config.toml

[general]
cursor_theme = "default"
cursor_size = 24

# Renderer used for each DRM device. Omitted means "opengl".
# "auto" tries OpenGL, then Vulkan, on that device.
# "vulkan" uses Vulkan and fails that device when the node lacks a required extension.
# Changing this requires a restart; a running compositor keeps its current renderer.
renderer = "opengl"

# Publish WAYLAND_DISPLAY, DISPLAY, XDG_CURRENT_DESKTOP, XDG_SESSION_TYPE and
# TEMA_SOCK to D-Bus activation and systemd --user, so portals and user
# services find the session. There is no IPC section: the socket path is fixed.
# Turn off when a session manager does this already. Ignored when nested. Applies on reload.
import_environment = false

# Allow a fullscreen window to tear when it asks through wp_tearing_control_v1.
# A per-output value under [output.tearing] replaces this for that connector.
allow_tearing = true

# Tiling gaps (logical pixels). Outer gap shrinks the tiling region inside the usable area;
# inner gap is space between sibling tiles. Fullscreen ignores gaps.
outer_gap = 10
inner_gap = 10

# Advertise wp_color_manager_v1. Changing this requires a restart.
[color_management]
enabled = true

# Xwayland starts lazily on the first X connection.
# Changes apply on reload; disabling lets running X apps finish.
[xwayland]
enabled = true

# "downscaled" lets X apps render at full resolution on HiDPI outputs.
# They must scale themselves (set GDK_SCALE=2 for GTK).
scaling_mode = "default"

# xdg-session-management: apps can ask tema to remember where their windows were.
# The file is $XDG_STATE_HOME/tema/sessions.json when that variable is set and
# not empty, otherwise $HOME/.local/state/tema/sessions.json. If neither is
# usable, the protocol is not advertised. Disabling hides it from new clients;
# stored data is kept. Applies on reload.
[session_management]
enabled = true

# Mouse move of a tiled window.
# threshold is logical pixels before the window is picked up; 0 picks it up immediately.
# precise_mouse_move false splits a wide tile left/right and a tall tile top/bottom.
# true uses the pointer quadrant. split_ratio 1.0 is an even split, clamped to 0.1..=1.9.
[tiling.drag]
threshold = 0
precise_mouse_move = false
split_ratio = 1.0

# Corner radius of the window content, in logical pixels. This is independent of
# who draws the decorations. 0 disables rounding.
# resize_grab_extent is the extra logical pixels outside a floating frame where a
# resize can start. Tiled windows resize through the borders and gap of a split;
# edges with no neighbour do not. 0 disables that extra extent.
[decorations]
rounding = 20
rounding_power = 2.0
resize_grab_extent = 10

# Width of the compositor frame on every edge, in logical pixels. This is also
# the drawn border width. Every non-fullscreen window gets this frame, including
# clients that draw their own decorations. A client that asks for client-side
# mode is still told to use server-side mode. 0 reserves no frame and draws no border.
[decorations.border]
size = 1
active_start_color = "#5078c8ff"
active_end_color = "#6b9df6ff"
inactive_start_color = "#333844ff"
inactive_end_color = "#434854ff"
gradient_angle_degrees = 0

# Simple compositor-owned shadow around the root window.
[decorations.shadow]
radius = 0
offset_x = 0
offset_y = 8
color = "#00000090"
power = 2.0

[effects.blur]
enabled = false
radius = 12
passes = 2

[effects.opacity]
active_alpha = 255
inactive_alpha = 230
inactive_dim = 24

# Speed is Hyprland's unit: the animation lasts speed * 100 milliseconds.
# A field you omit keeps the value below. windowsMove is absent, so it inherits windows.
# Built-in curves include default, linear, easeOutQuint, easeInOutCubic, almostLinear, and quick.
[animations.bezier.easeOutQuint]
points = [0.23, 1.0, 0.32, 1.0]

[animations.bezier.almostLinear]
points = [0.5, 0.5, 0.75, 1.0]

[animations.bezier.quick]
points = [0.15, 0.0, 0.1, 1.0]

[animations.global]
enabled = true
speed = 10.0
bezier = "default"

[animations.windows]
enabled = true
speed = 4.79
bezier = "easeOutQuint"

[animations.windowsIn]
enabled = true
speed = 4.1
bezier = "easeOutQuint"
style = "popin 87%"

[animations.windowsOut]
enabled = true
speed = 1.49
bezier = "linear"
style = "popin 87%"

[animations.fade]
enabled = true
speed = 3.03
bezier = "quick"

[animations.fadeIn]
enabled = true
speed = 1.73
bezier = "almostLinear"

[animations.fadeOut]
enabled = true
speed = 1.46
bezier = "almostLinear"

[animations.workspaces]
enabled = true
speed = 1.94
bezier = "almostLinear"
# fade keeps the horizontal slide and also fades workspace opacity. slide leaves that side opaque.
style = "fade"

[animations.workspacesIn]
enabled = true
speed = 1.21
bezier = "almostLinear"
style = "fade"

[animations.workspacesOut]
enabled = true
speed = 1.94
bezier = "almostLinear"
style = "fade"

[bindings]
# Key names follow xkb (e.g. Super, Ctrl, Alt, Shift). Last segment is the key.
# Ctrl+Alt+F1..F12 switch VT (built in); bindings on those chords never fire.
"Super+Escape" = { action = "quit" }
"Super+Shift+C" = { action = "reload-config" }
"Super+Return" = { action = "spawn", command = "alacritty" }
"Super+Q" = { action = "close" }
"Super+Left" = { action = "focus-previous" }
"Super+Right" = { action = "focus-next" }
"Super+Space" = { action = "toggle-floating" }
"Super+F" = { action = "toggle-fullscreen" }
# Restore (or give back) compositor shortcuts when a VM or remote desktop grabbed them.
"Super+Shift+Escape" = { action = "toggle-shortcuts-inhibit" }
# Each output starts with four workspaces. Page Up and Page Down wrap through that list.
"Super+Page_Up" = { action = "workspace-next" }
"Super+Page_Down" = { action = "workspace-previous" }
# Number keys select a workspace by its one-based index. Shift moves the focused window there.
"Super+1" = { action = "workspace-index", index = 1 }
"Super+2" = { action = "workspace-index", index = 2 }
"Super+3" = { action = "workspace-index", index = 3 }
"Super+4" = { action = "workspace-index", index = 4 }
"Super+Shift+1" = { action = "move-to-workspace", index = 1 }
"Super+Shift+2" = { action = "move-to-workspace", index = 2 }
"Super+Shift+3" = { action = "move-to-workspace", index = 3 }
"Super+Shift+4" = { action = "move-to-workspace", index = 4 }

[mouse_bindings]
# Mouse bindings use modifier names plus `mouse:<button>`.
# Supported button aliases: left, right, middle. Raw Linux button codes also work.
"Ctrl+mouse:left" = { action = "move-window" }
"Ctrl+mouse:right" = { action = "resize-window" }

# Optional: fixed scale per DRM output name, or "auto".
# [output.scales]
# "DP-1" = "auto"
# "eDP-1" = 1.25

# Optional: replace general.allow_tearing for one connector. Names match wl_output.name.
# [output.tearing]
# "DP-1" = false
# "eDP-1" = true

# Optional: SDR image description per connector. Names match wl_output.name and are
# case-sensitive. Omitted connectors use tf "gamma22", primaries "srgb", sdr_white 80,
# and bitdepth 8. tf "srgb" is the IEC 61966-2-1 piecewise curve. primaries "edid" reads
# the base-block chromaticities and falls back to sRGB when the EDID has none or they
# are unusable. Luminance minimum stays 0.2; maximum and reference white are both
# sdr_white. bitdepth 10 prefers an XRGB2101010 scanout buffer, then XBGR2101010, and
# sets the connector max bpc to 10. Allocation or modeset failure falls back to 8-bit.
# mode "hdr" asks for PQ with BT.2020 primaries. It stays SDR unless the EDID reports
# PQ and BT.2020 RGB and the connector has Colorspace=BT2020_RGB and HDR_OUTPUT_METADATA.
# An omitted sdr_white is 203 while that HDR mode is active. min_luminance, max_luminance,
# and max_fall replace the EDID mastering range when set.
# [output.color]
# "DP-1" = { tf = "gamma22", primaries = "edid", sdr_white = 80, bitdepth = 8 }
# "eDP-1" = { mode = "hdr", bitdepth = 10 }
